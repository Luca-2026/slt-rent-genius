RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Force www
RewriteCond %{HTTP_HOST} ^slt-rental\.de$ [NC]
RewriteRule ^(.*)$ https://www.slt-rental.de/$1 [R=301,L]

# ===== Legacy URL 301 Redirects (SEO) =====

# Old solution pages with short slugs
RewriteRule ^loesungen/hochbau$ /loesungen/hochbau-renovierung [R=301,L]
RewriteRule ^loesungen/tiefbau$ /loesungen/tiefbau-erdbewegung [R=301,L]
RewriteRule ^loesungen/galabau$ /loesungen/garten-landschaftsbau [R=301,L]
RewriteRule ^loesungen/events$ /loesungen/events-veranstaltungen [R=301,L]
RewriteRule ^loesungen/handwerk$ /loesungen/handwerk-gewerbe [R=301,L]
RewriteRule ^loesungen/transport$ /loesungen/umzug-transport [R=301,L]
RewriteRule ^loesungen/kinder$ /loesungen/kindergeburtstage [R=301,L]

# Old knowledge base URL
RewriteRule ^wissensbasis$ /hilfe [R=301,L]

# Old standalone location pages (with hyphen)
RewriteRule ^standort-krefeld$ /standorte/krefeld [R=301,L]
RewriteRule ^standort-bonn$ /standorte/bonn [R=301,L]
RewriteRule ^standort-duisburg$ /standorte/muelheim [R=301,L]
RewriteRule ^standort-muelheim$ /standorte/muelheim [R=301,L]

# Old /standort/{id} URLs (without 'e') — high GSC traffic
RewriteRule ^standort/krefeld$ /mieten/krefeld [R=301,L]
RewriteRule ^standort/bonn$ /mieten/bonn [R=301,L]
RewriteRule ^standort/muelheim$ /mieten/muelheim [R=301,L]
RewriteRule ^standort/muehlheim$ /mieten/muelheim [R=301,L]

# Old paginated /produkte with query params → /mieten
RewriteCond %{QUERY_STRING} .+
RewriteRule ^produkte$ /mieten? [R=301,L]

# Old paginated location pages: /produkte-krefeld?page=X → /mieten/krefeld
RewriteCond %{QUERY_STRING} .+
RewriteRule ^produkte-krefeld$ /mieten/krefeld? [R=301,L]
RewriteRule ^produkte-krefeld$ /mieten/krefeld [R=301,L]
RewriteRule ^produkte-bonn$ /mieten/bonn [R=301,L]
RewriteRule ^produkte-muelheim$ /mieten/muelheim [R=301,L]
RewriteRule ^produkte-duisburg$ /mieten/muelheim [R=301,L]

# Old category routes: /kategorien-krefeld/{cat} → /mieten/krefeld/{cat}
RewriteRule ^kategorien-krefeld/rigging$ /mieten/krefeld/traversen-rigging [R=301,L]
RewriteRule ^kategorien-krefeld/buehnen$ /mieten/krefeld/buehne [R=301,L]
RewriteRule ^kategorien-krefeld/(.+)$ /mieten/krefeld/$1 [R=301,L]

# Old category routes for Bonn: /kategorien-bonn/{cat} → /mieten/bonn/{cat}
RewriteRule ^kategorien-bonn/(.+)$ /mieten/bonn/$1 [R=301,L]

# Old category routes WITHOUT location prefix: /kategorien/{cat} → /mieten/krefeld/{cat}
RewriteRule ^kategorien/rigging$ /mieten/krefeld/traversen-rigging [R=301,L]
RewriteRule ^kategorien/buehnen$ /mieten/krefeld/buehne [R=301,L]
RewriteRule ^kategorien/strom.*$ /mieten/krefeld/aggregate [R=301,L]
RewriteRule ^kategorien/bagger.*$ /mieten/krefeld/erdbewegung [R=301,L]
RewriteRule ^kategorien/(.+)$ /mieten/krefeld/$1 [R=301,L]

# Typo: /kategroien-duisburg/ (missing 'e' in kategorien) → /mieten/muelheim/
RewriteRule ^kategroien-duisburg/bagger-dumper$ /mieten/muelheim/erdbewegung [R=301,L]
RewriteRule ^kategroien-duisburg/(.+)$ /mieten/muelheim/$1 [R=301,L]

# Old compound category routes: /kategorie/krefeld-{cat} → /mieten/krefeld/{cat}
RewriteRule ^kategorie/krefeld-(.+?)(?:Zus|Tarife.*|Die)?$ /mieten/krefeld/$1 [R=301,L,NC]
RewriteRule ^kategorie/bonn-(.+?)(?:Zus|Tarife.*|Die)?$ /mieten/bonn/$1 [R=301,L,NC]
RewriteRule ^kategorie/(.+)$ /mieten/krefeld/$1 [R=301,L]

# Strip junk suffixes from /mieten/ URLs (Die, Ebenso, Tarif*, Zus etc.)
RewriteRule ^(mieten/[^/]+/[a-z0-9-]+?)(Die|Ebenso|Tarif.*)$ /$1 [R=301,L,NC]

# Old location-specific product routes → SPA handles the redirect
RewriteRule ^produkte-bonn/(.+)$ /mieten/bonn/alle?legacy=$1 [R=301,L]
RewriteRule ^produkte-duisburg/(.+)$ /mieten/muelheim/alle?legacy=$1 [R=301,L]
RewriteRule ^produkte-muelheim/(.+)$ /mieten/muelheim/alle?legacy=$1 [R=301,L]

# Old product detail routes: /produkte/{slug} → SPA handles lookup
RewriteCond %{REQUEST_URI} ^/produkte/[^/]+$
RewriteRule ^produkte/(.+)$ /mieten/krefeld/alle?legacy=$1 [R=301,L]

# Old Geschirr/Gläser product slugs with wrong piece counts
RewriteRule ^mieten/([^/]+)/geschirr-glaeser-besteck/longdrinkglas-passionata-10er$ /mieten/$1/geschirr-glaeser-besteck/longdrinkglas-passionata-25er [R=301,L]
RewriteRule ^mieten/([^/]+)/geschirr-glaeser-besteck/champagnerglas-brunelli-14er$ /mieten/$1/geschirr-glaeser-besteck/champagnerglas-brunelli-36er [R=301,L]
RewriteRule ^mieten/([^/]+)/geschirr-glaeser-besteck/rieslingglas-brunelli-12er$ /mieten/$1/geschirr-glaeser-besteck/weissweinglas-brunelli-25er [R=301,L]
RewriteRule ^mieten/([^/]+)/geschirr-glaeser-besteck/burgunderglas-brunelli-10er$ /mieten/$1/geschirr-glaeser-besteck/rotweinglas-brunelli-9er [R=301,L]

# ===== End Legacy Redirects =====

# ===== Manuals: block indexing of PDF manuals =====
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# ===== Bot Meta-Tag Prerendering =====
# Route social media crawlers through PHP for correct OG meta tags
RewriteCond %{HTTP_USER_AGENT} Googlebot|bingbot|facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Embedly|pinterest|vkShare|redditbot|Viber|Skype|kakaotalk|Applebot|DuckDuckBot|Yandex|Baiduspider [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /meta-prerender.php [L]

# SPA: Route all requests to index.html (unless file/directory exists)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

# Cache static assets (JS, CSS, images, fonts)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Set default charset
AddDefaultCharset UTF-8

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
