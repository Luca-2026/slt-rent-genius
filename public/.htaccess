# =====================================================
# SLT Rental – Apache .htaccess (Serverprofis Hosting)
# =====================================================

# ---- Default Charset ----
AddDefaultCharset UTF-8

# ---- Enable Rewrite Engine ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www (Canonical: https://www.slt-rental.de)
  RewriteCond %{HTTP_HOST} ^slt-rental\.de [NC]
  RewriteRule ^ https://www.slt-rental.de%{REQUEST_URI} [L,R=301]

  # =====================================================
  # Legacy URL Redirects (alte Webflow-Pfade -> neue Struktur)
  # =====================================================

  # --- Alte Standort "duisburg" gibt es nicht mehr -> Krefeld ist nächstgelegen ---
  RewriteRule ^produkte-duisburg/?$ /mieten/krefeld/ [L,R=301]
  RewriteRule ^produkte-duisburg/(.*)$ /mieten/krefeld/ [L,R=301]

  # --- Kategorie-Slug-Normalisierung (alt -> neu) für /kategorien-{loc}/{cat} und /produkte/{cat} ---
  # anhanger -> anhaenger
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/anhanger/?$ /mieten/$1/anhaenger/ [L,R=301]
  RewriteRule ^produkte/anhanger/?$ /mietartikel/ [L,R=301]
  # bagger-radlader / bagger-dumper / ketten-dumper -> erdbewegung
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/(bagger-radlader|bagger-dumper|ketten-dumper)/?$ /mieten/$1/erdbewegung/ [L,R=301]
  RewriteRule ^produkte/(bagger-radlader|bagger-dumper|ketten-dumper)/?$ /mietartikel/ [L,R=301]
  # buehnen-podeste -> buehne
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/buehnen-podeste/?$ /mieten/$1/buehne/ [L,R=301]
  RewriteRule ^produkte/buehnen-podeste/?$ /mietartikel/ [L,R=301]
  # absperrung-sicherheit -> absperrtechnik
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/absperrung-sicherheit/?$ /mieten/$1/absperrtechnik/ [L,R=301]
  RewriteRule ^produkte/absperrung-sicherheit/?$ /mietartikel/ [L,R=301]
  # rigging -> traversen-rigging
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/rigging/?$ /mieten/$1/traversen-rigging/ [L,R=301]
  # led-spots -> beleuchtung
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/led-spots/?$ /mieten/$1/beleuchtung/ [L,R=301]
  RewriteRule ^produkte/led-spots/?$ /mietartikel/ [L,R=301]
  # heizung-klima -> heizung-trocknung
  RewriteRule ^produkte/heizung-klima/?$ /mietartikel/ [L,R=301]
  # geschirr -> geschirr-glaeser-besteck
  RewriteRule ^produkte/geschirr/?$ /mietartikel/ [L,R=301]
  # gutscheine: keine Kategorie mehr -> Standortseite
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/gutscheine/?$ /mieten/$1/ [L,R=301]

  # --- Generische Kategorie-Pfade (Slug stimmt 1:1 mit neuer Kategorie überein) ---
  # /kategorien-{loc}/{cat} -> /mieten/{loc}/{cat}/
  RewriteRule ^kategorien-(bonn|krefeld|muelheim)/([a-z0-9-]+)/?$ /mieten/$1/$2/ [L,R=301]
  # /produkte/{cat-known} -> /mietartikel/  (Kategorie ohne Standort -> Katalog)
  RewriteRule ^produkte/(anhaenger|arbeitsbuehnen|beleuchtung|beschallung|erdbewegung|gartenpflege|geschirr-glaeser-besteck|heizung-trocknung|huepfburgen|kabel-stromverteiler|kommunikation|leitern-gerueste|moebel-zelte|spezialeffekte|traversen-rigging|verdichtung|werkzeuge|aggregate|absperrtechnik|buehne)/?$ /mietartikel/ [L,R=301]

  # --- Standort-Pfade ohne Kategorie ---
  # /produkte-{loc}            -> /mieten/{loc}/
  # /produkte-{loc}/{slug}     -> /mieten/{loc}/  (Slug-Mapping nicht möglich, Standort ist beste Annäherung)
  RewriteRule ^produkte-(bonn|krefeld|muelheim)/?$ /mieten/$1/ [L,R=301]
  RewriteRule ^produkte-(bonn|krefeld|muelheim)/(.+)$ /mieten/$1/ [L,R=301]

  # --- Catch-all für alle übrigen alten /produkte/{slug} -> Hauptkatalog ---
  RewriteRule ^produkte/?$ /mietartikel/ [L,R=301]
  RewriteRule ^produkte/(.+)$ /mietartikel/ [L,R=301]


  # Add trailing slash (Canonical-Form, außer für Dateien mit Endung)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.+)/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # SPA Fallback – alle nicht existierenden Routen auf index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ index.html [L]
</IfModule>

# ---- MIME Types ----
<IfModule mod_mime.c>
  AddType application/javascript            .js .mjs
  AddType text/css                          .css
  AddType image/svg+xml                     .svg .svgz
  AddType image/webp                        .webp
  AddType image/avif                        .avif
  AddType application/json                  .json
  AddType application/manifest+json         .webmanifest
  AddType application/xml                   .xml
  AddType font/woff                         .woff
  AddType font/woff2                        .woff2
  AddType application/pdf                   .pdf
</IfModule>

# ---- Compression (Gzip / Deflate) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ---- Browser Caching ----
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML – nie cachen, damit Updates sofort sichtbar
  ExpiresByType text/html                  "access plus 0 seconds"

  # Assets mit Hash – 1 Jahr
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType image/jpeg                 "access plus 6 months"
  ExpiresByType image/png                  "access plus 6 months"
  ExpiresByType image/webp                 "access plus 6 months"
  ExpiresByType image/avif                 "access plus 6 months"
  ExpiresByType image/svg+xml              "access plus 6 months"
  ExpiresByType font/woff                  "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType application/pdf            "access plus 1 month"

  # SEO-Dateien – täglich neu prüfen
  ExpiresByType application/xml            "access plus 1 day"
  ExpiresByType text/xml                   "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Hashed Assets immutable
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML / SEO-Dateien nie cachen
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ---- Custom Error Page (SPA übernimmt 404 selbst) ----
ErrorDocument 404 /index.html

# ---- Schutz: Versteckte Dateien ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>

# ---- Disable Directory Listing ----
Options -Indexes
